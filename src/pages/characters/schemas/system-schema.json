{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ListSchemaRead",
  "definitions": {
    "ListSchemaRead": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/definitions/CharacterSchema"
        }
      },
      "required": ["name", "schema"],
      "additionalProperties": false
    },
    "CharacterSchema": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Section"
          }
        },
        "layout": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LayoutItem"
          }
        }
      },
      "required": ["sections"],
      "additionalProperties": false
    },
    "LayoutItem": {
      "type": "object",
      "properties": {
        "i": {
          "type": "string",
          "description": "Идентификатор элемента сетки (обычно совпадает с заголовком секции)"
        },
        "x": {
          "type": "number",
          "description": "Позиция по X в единицах сетки"
        },
        "y": {
          "type": "number",
          "description": "Позиция по Y в единицах сетки"
        },
        "w": {
          "type": "number",
          "description": "Ширина в единицах сетки"
        },
        "h": {
          "type": "number",
          "description": "Высота в единицах сетки"
        },
        "minW": {
          "type": "number"
        },
        "minH": {
          "type": "number"
        },
        "maxW": {
          "type": "number"
        },
        "maxH": {
          "type": "number"
        },
        "static": {
          "type": "boolean"
        }
      },
      "required": ["i", "x", "y", "w", "h"],
      "additionalProperties": true
    },
    "Section": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Field"
          }
        },
        "layout": {
          "type": "string",
          "enum": ["unbound", "compact", "list"]
        },
        "columns": {
          "type": "number"
        }
      },
      "required": ["title", "fields"],
      "additionalProperties": false
    },
    "Field": {
      "anyOf": [
        {
          "$ref": "#/definitions/NumberField"
        },
        {
          "$ref": "#/definitions/TextField"
        },
        {
          "$ref": "#/definitions/TextareaField"
        },
        {
          "$ref": "#/definitions/SelectField"
        },
        {
          "$ref": "#/definitions/CheckboxField"
        },
        {
          "$ref": "#/definitions/ArrayField"
        },
        {
          "$ref": "#/definitions/MinMaxField"
        },
        {
          "$ref": "#/definitions/HeaderField"
        }
      ]
    },
    "HeaderField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "header"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "type"]
    },
    "NumberField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "number"
        },
        "defaultValue": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "type"]
    },
    "TextField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "defaultValue": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "type"]
    },
    "TextareaField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "textarea"
        },
        "defaultValue": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "type"]
    },
    "SelectField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "select"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultValue": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "options", "type"]
    },
    "CheckboxField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "checkbox"
        },
        "defaultValue": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "type"]
    },
    "ArrayField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "array"
        },
        "itemSchema": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Field"
          }
        },
        "defaultValue": {
          "type": "array",
          "items": {}
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["itemSchema", "label", "type"]
    },
    "MinMaxField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "minmax"
        },
        "defaultValue": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "ui": {
          "type": "string",
          "enum": ["row", "column", "compact"]
        },
        "array_col": {
          "type": "number"
        }
      },
      "required": ["label", "type"]
    }
  }
}
